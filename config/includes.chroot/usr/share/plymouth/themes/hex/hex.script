Window.SetBackgroundTopColor(0.027, 0.043, 0.075);
Window.SetBackgroundBottomColor(0.040, 0.100, 0.130);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10);

bar.image = Image("bar.png");
bar.sprite = Sprite();
bar.w = 360;
bar.x = Window.GetWidth() / 2 - bar.w / 2;
bar.y = logo.y + logo.image.GetHeight() + 50;
bar.sprite.SetPosition(bar.x, bar.y, 10);

frame = 0;
fun refresh_callback() {
  frame++;
  logo.sprite.SetOpacity(0.72 + 0.28 * Math.Sin(frame / 18));
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
  bar.sprite.SetImage(bar.image.Scale(Math.Int(bar.w * progress) + 4, 6));
}
Plymouth.SetBootProgressFunction(progress_callback);

pw.sprite = Sprite();
fun display_password_callback(prompt, bullets) {
  txt = prompt + "  ";
  for (i = 0; i < bullets; i++) txt = txt + "*";
  pw.image = Image.Text(txt, 1, 1, 1);
  pw.sprite.SetImage(pw.image);
  pw.sprite.SetPosition(Window.GetWidth() / 2 - pw.image.GetWidth() / 2, bar.y + 40, 20);
  pw.sprite.SetOpacity(1);
}
fun display_normal_callback() { pw.sprite.SetOpacity(0); }
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
