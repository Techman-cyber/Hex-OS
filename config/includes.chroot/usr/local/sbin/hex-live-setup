#!/bin/bash
# Live session only. Makes sure the live account exists with a known password, then enables auto-login for it.
# Nothing here is stored in the installed system (it runs at boot, after the installer's copy is made).
[ -d /run/live ] || exit 0
U=user; P=live
id "$U" >/dev/null 2>&1 || useradd -m -s /bin/bash -c "HEX OS Live" "$U"
for g in sudo audio video plugdev netdev cdrom dip bluetooth lpadmin scanner; do
  getent group "$g" >/dev/null 2>&1 && usermod -aG "$g" "$U"
done
echo "$U:$P" | chpasswd
passwd -u "$U" >/dev/null 2>&1 || true
chage -E -1 -I -1 -m 0 -M -1 -d "$(date +%F)" "$U" 2>/dev/null || true
chown -R "$U:$U" "/home/$U" 2>/dev/null || true
# Passwordless sudo for the live session only (needed by the installer button)
echo "$U ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/hex-live
chmod 440 /etc/sudoers.d/hex-live
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-hex-live-autologin.conf <<EOT
[Seat:*]
autologin-user=$U
autologin-user-timeout=0
autologin-session=xfce
EOT
exit 0
