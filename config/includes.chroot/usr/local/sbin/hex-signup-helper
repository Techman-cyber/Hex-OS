#!/usr/bin/python3
"""HEX sign-up helper. Runs as root through sudo, for the login screen only.
Input on stdin, one per line: new username, full name, new password, administrator username, administrator password.
It creates a STANDARD (non-admin) account, and only if the administrator's password is correct."""
import sys, re, time, subprocess, grp, pwd
try:
    import spwd, crypt
except ImportError:
    print("ERR This system cannot verify administrator passwords."); sys.exit(3)

def fail(msg, delay=0):
    if delay: time.sleep(delay)
    print("ERR " + msg); sys.exit(2)

lines = sys.stdin.read().split("\n")
if len(lines) < 5: fail("Missing information.")
user, full, pw, admin, apw = lines[:5]
if not re.fullmatch(r"[a-z][a-z0-9_-]{0,30}", user):
    fail("Username: use lowercase letters and numbers, starting with a letter.")
if len(pw) < 4:
    fail("The new password needs at least 4 characters.")
full = re.sub(r"[:,\n]", " ", full)[:60]
try:
    pwd.getpwnam(user)
    exists = True
except KeyError:
    exists = False
if exists:
    fail("That username already exists.")

ok = False
try:
    h = spwd.getspnam(admin).sp_pwdp
    if h and h[0] not in "!*":
        v = crypt.crypt(apw, h)
        if v is None or v.startswith("*"):
            fail("This system cannot verify administrator passwords.")
        ok = v == h
    sudo = grp.getgrnam("sudo")
    ok = ok and (admin in sudo.gr_mem or pwd.getpwnam(admin).pw_gid == sudo.gr_gid)
except (KeyError, OSError):
    ok = False
if not ok:
    fail("The administrator name or password is wrong.", delay=2)

groups = []
for g in ("audio", "video", "plugdev", "netdev"):
    try:
        grp.getgrnam(g); groups.append(g)
    except KeyError:
        pass
cmd = ["useradd", "-m", "-s", "/bin/bash", "-c", full]
if groups: cmd += ["-G", ",".join(groups)]
cmd.append(user)
if subprocess.run(cmd, capture_output=True).returncode != 0:
    fail("Could not create the account.")
r = subprocess.run(["chpasswd"], input=f"{user}:{pw}\n", text=True, capture_output=True)
if r.returncode != 0:
    subprocess.run(["userdel", "-r", user], capture_output=True)
    fail("Could not set the password.")
print("OK")
