#!/usr/bin/env bash
# Power menu: log out, restart, shut down, lock.
C=$(zenity --list --title="Power" --text="What would you like to do?" --column=id --column="Choose" --hide-column=1 --print-column=1 --width=340 --height=300 \
     lock "Lock the screen" logout "Log out" restart "Restart" shutdown "Shut down") || exit 0
case "$C" in
  lock) xflock4 ;;
  logout) xfce4-session-logout --logout --fast ;;
  restart) xfce4-session-logout --reboot --fast ;;
  shutdown) xfce4-session-logout --halt --fast ;;
esac
