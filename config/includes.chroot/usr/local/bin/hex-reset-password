#!/usr/bin/env bash
# Reset a forgotten password of an INSTALLED system. Run this from the HEX live USB (Welcome > Reset a forgotten password).
if [ "$EUID" -ne 0 ]; then
  if sudo -n true 2>/dev/null; then exec sudo -E bash "$0" "$@"; else exec pkexec env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" bash "$0" "$@"; fi
fi
MNT=/mnt/hex-reset; mkdir -p "$MNT"
if [ -d /run/live ] ; then :; else
  zenity --warning --no-wrap --title="Reset password" --text="Run this from the HEX live USB.\nIt resets the password of a system installed on the disk, which cannot be done while that system is running."; exit 1
fi
parts=()
while read -r name fstype; do
  case "$fstype" in ext4|ext3|ext2|btrfs|xfs|f2fs) parts+=("/dev/$name" "$fstype") ;; esac
done < <(lsblk -rno NAME,FSTYPE,TYPE | awk '$3=="part"||$3=="lvm"{print $1,$2}')
[ ${#parts[@]} -gt 0 ] || { zenity --error --no-wrap --text="No Linux disk was found.\n(Encrypted disks are not supported by this tool.)"; exit 1; }
DEV=$(zenity --list --title="Which disk has your HEX OS?" --column=Disk --column=Type --width=420 --height=320 "${parts[@]}") || exit 0
umount "$MNT" 2>/dev/null
mount "$DEV" "$MNT" || { zenity --error --text="Could not open $DEV."; exit 1; }
if [ ! -f "$MNT/etc/shadow" ]; then
  umount "$MNT"; zenity --error --no-wrap --text="No Linux system found on $DEV.\nTry another disk."; exit 1
fi
users=$(awk -F: '($3>=1000 && $3<60000) || $1=="root" {print $1}' "$MNT/etc/passwd")
USR=$(zenity --list --title="Whose password?" --column=Account $users --height=300) || { umount "$MNT"; exit 0; }
P1=$(zenity --password --title="New password for $USR") || { umount "$MNT"; exit 0; }
P2=$(zenity --password --title="Repeat the new password") || { umount "$MNT"; exit 0; }
if [ -z "$P1" ] || [ "$P1" != "$P2" ]; then umount "$MNT"; zenity --error --text="The passwords were empty or did not match."; exit 1; fi
if printf '%s:%s\n' "$USR" "$P1" | chpasswd -R "$MNT" && passwd -R "$MNT" -u "$USR" >/dev/null 2>&1; then
  sync; umount "$MNT"
  zenity --info --no-wrap --title="Done" --text="The password for '$USR' was changed.\nRestart without the USB and log in with the new password."
else
  umount "$MNT"; zenity --error --text="Could not change the password."; exit 1
fi
