#!/usr/bin/env bash
# Starts the HEX dock: big icons on the right side, always visible, no zoom. Settings are applied once, before it starts.
[ -f "$HOME/.config/hex-dock-off" ] && exit 0
M="$HOME/.config/hex-dock-configured-v2"
if [ ! -f "$M" ]; then
  D="net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/"
  gsettings set "$D" position 'right'
  gsettings set "$D" alignment 'center'
  gsettings set "$D" zoom-enabled false
  gsettings set "$D" icon-size 64
  gsettings set "$D" hide-mode 'none'
  gsettings set "$D" theme 'Transparent'
  touch "$M"
fi
exec plank
