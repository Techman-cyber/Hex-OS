#!/bin/sh
# Starts the HEX login screen. If it cannot start, the standard greeter takes over, so logging in always works.
/usr/bin/python3 /usr/local/bin/hex-greeter 2>/tmp/hex-greeter.log &
PID=$!
START=$(date +%s)
trap 'kill $PID 2>/dev/null; exit 0' TERM INT
wait $PID
RC=$?
NOW=$(date +%s)
if [ "$RC" -ne 0 ] && [ $((NOW - START)) -lt 15 ]; then exec lightdm-gtk-greeter; fi
exit "$RC"
