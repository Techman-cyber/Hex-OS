#!/usr/bin/python3
"""HEX Settings: one clean place for everything, with search."""
import os, platform, shlex, subprocess
import gi
gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk

CSS = b"""
window { background-color: #0a111c; }
.title { font-size: 26px; font-weight: 300; color: #f2f7fb; }
.tile { background-image: none; background-color: #0e1a2b; border: 1px solid #1d3347; border-radius: 16px; padding: 16px; min-width: 230px; min-height: 92px; }
.tile:hover { background-color: #17283d; border-color: #19b0a1; }
.ticon { font-size: 30px; }
.tname { font-size: 15px; font-weight: 700; color: #ecf4fa; }
.tsub { font-size: 12px; color: #9fb3c8; }
.group { font-size: 12px; font-weight: 700; color: #96ebcd; letter-spacing: 1px; }
entry { min-height: 42px; border-radius: 12px; background-color: #17283d; border: 1px solid #3a5a74; color: #fff; padding: 0 14px; font-size: 14px; }
"""
ITEMS = [
 ("Connectivity", "📶", "Network and Wi-Fi", "Wi-Fi, Ethernet, connections", "python3 /usr/local/bin/hex-wifi"),
 ("Connectivity", "🔵", "Bluetooth", "Pair headphones, mice, phones", "blueman-manager"),
 ("Device", "🖥️", "Display", "Resolution, scale, multiple screens", "xfce4-display-settings"),
 ("Device", "🔊", "Sound", "Volume, speakers, microphone", "pavucontrol"),
 ("Device", "🔋", "Power and battery", "Sleep, lid, battery saver", "xfce4-power-manager-settings"),
 ("Device", "⌨️", "Keyboard and shortcuts", "Layout, repeat, hotkeys", "xfce4-keyboard-settings"),
 ("Device", "🖱️", "Mouse and touchpad", "Speed, scrolling, buttons", "xfce4-mouse-settings"),
 ("Personalise", "🎨", "Appearance", "Themes, icons, fonts", "xfce4-appearance-settings"),
 ("Personalise", "🖼️", "Wallpaper and desktop", "Pictures, icons on the desktop", "xfdesktop-settings"),
 ("Personalise", "✨", "Windows and animations", "Window style, snapping, effects", "xfwm4-settings"),
 ("Personalise", "🔔", "Notifications", "Pop-ups and do not disturb", "xfce4-notifyd-config"),
 ("System", "👤", "Accounts", "Create a new account", "bash /usr/local/bin/hex-add-user"),
 ("System", "📦", "Apps and updates", "Install apps, Debian and Flathub", "xfce4-terminal -x bash /usr/local/bin/hex-apps"),
 ("System", "🛟", "Backup and restore", "System snapshots (Timeshift)", "timeshift-launcher"),
 ("System", "🧭", "Default apps", "Which app opens which file", "xfce4-mime-settings"),
 ("System", "🧰", "Troubleshooting report", "Save a report to get help", "bash /usr/local/bin/hex-diagnose"),
 ("System", "ℹ️", "About HEX OS", "Version, computer details", "ABOUT"),
]

def about(parent):
    def rd(p, key):
        try: return [l.split("=", 1)[1].strip().strip('"') for l in open(p) if l.startswith(key + "=")][0]
        except Exception: return "?"
    cpu = "?"
    try: cpu = [l.split(":", 1)[1].strip() for l in open("/proc/cpuinfo") if l.startswith("model name")][0]
    except Exception: pass
    try: mem = [int(l.split()[1]) for l in open("/proc/meminfo") if l.startswith("MemTotal")][0] / 1048576
    except Exception: mem = 0
    virt = subprocess.run(["systemd-detect-virt"], capture_output=True, text=True).stdout.strip()
    text = "%s\n\nDevice name:  %s\nProcessor:  %s\nMemory:  %.1f GB\nKernel:  %s\nRunning in:  %s" % (rd("/etc/os-release", "PRETTY_NAME"), platform.node(), cpu, mem, platform.release(), "a virtual machine (%s)" % virt if virt and virt != "none" else "a real computer")
    d = Gtk.MessageDialog(transient_for=parent, modal=True, message_type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.CLOSE, text="About HEX OS"); d.format_secondary_text(text); d.run(); d.destroy()

class Settings(Gtk.Window):
    def __init__(self):
        super().__init__(title="HEX Settings"); self.set_default_size(1000, 680); self.set_position(Gtk.WindowPosition.CENTER)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16); root.set_border_width(26); self.add(root)
        t = Gtk.Label(label="Settings"); t.set_xalign(0); t.get_style_context().add_class("title"); root.pack_start(t, False, False, 0)
        self.search = Gtk.SearchEntry(); self.search.set_placeholder_text("Search settings"); self.search.connect("search-changed", lambda *_: self.refilter()); root.pack_start(self.search, False, False, 0)
        sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC); root.pack_start(sc, True, True, 0)
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); sc.add(self.body)
        self.groups = []
        for g in ("Connectivity", "Device", "Personalise", "System"):
            lab = Gtk.Label(label=g.upper()); lab.set_xalign(0); lab.get_style_context().add_class("group"); self.body.pack_start(lab, False, False, 4)
            fb = Gtk.FlowBox(); fb.set_selection_mode(Gtk.SelectionMode.NONE); fb.set_max_children_per_line(5); fb.set_column_spacing(12); fb.set_row_spacing(12); fb.set_homogeneous(True)
            fb.set_filter_func(self.filt); self.body.pack_start(fb, False, False, 0); self.groups.append((lab, fb))
            for grp, ico, name, sub, cmd in ITEMS:
                if grp != g: continue
                b = Gtk.Button(); b.set_relief(Gtk.ReliefStyle.NONE); b.get_style_context().add_class("tile"); b.item = (name + " " + sub).lower()
                row = Gtk.Box(spacing=14); i = Gtk.Label(label=ico); i.get_style_context().add_class("ticon"); row.pack_start(i, False, False, 0)
                v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3); v.set_valign(Gtk.Align.CENTER)
                a = Gtk.Label(label=name); a.set_xalign(0); a.get_style_context().add_class("tname"); v.pack_start(a, False, False, 0)
                s = Gtk.Label(label=sub); s.set_xalign(0); s.set_line_wrap(True); s.set_max_width_chars(26); s.get_style_context().add_class("tsub"); v.pack_start(s, False, False, 0)
                row.pack_start(v, True, True, 0); b.add(row); b.connect("clicked", lambda _b, c=cmd: self.run(c)); fb.add(b)
        self.connect("destroy", Gtk.main_quit); self.show_all()
    def filt(self, child):
        q = self.search.get_text().strip().lower(); return not q or q in child.get_child().item
    def refilter(self):
        for lab, fb in self.groups:
            fb.invalidate_filter(); vis = any(c.get_mapped() or True for c in fb.get_children())
            lab.set_visible(any(not self.search.get_text().strip() or self.search.get_text().strip().lower() in c.get_child().item for c in fb.get_children()))
    def run(self, cmd):
        if cmd == "ABOUT": about(self); return
        try: subprocess.Popen(shlex.split(cmd), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except Exception: pass

def main():
    p = Gtk.CssProvider(); p.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    Settings(); Gtk.main()

if __name__ == "__main__":
    main()
