#!/usr/bin/python3
"""HEX Widgets: weather, calendar and news in a panel that slides in above the taskbar. Open with Win+W."""
import json, os, subprocess, threading, time, urllib.parse, urllib.request, xml.etree.ElementTree as ET
from email.utils import parsedate_to_datetime
import gi
gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib

CFG = os.path.expanduser("~/.config/hex-widgets.json")
CACHE = os.path.expanduser("~/.cache/hex-weather.json")
CLOSED = "/tmp/.hex-widgets-closed-%d" % os.getuid()
FEEDS = [["BBC World", "https://feeds.bbci.co.uk/news/world/rss.xml"],
         ["Hacker News", "https://hnrss.org/frontpage"],
         ["NASA", "https://www.nasa.gov/rss/dyn/breaking_news.rss"]]
ICON = {0: "☀️", 1: "🌤️", 2: "⛅", 3: "☁️", 45: "🌫️", 48: "🌫️", 51: "🌦️", 53: "🌦️", 55: "🌦️", 56: "🌧️", 57: "🌧️",
        61: "🌧️", 63: "🌧️", 65: "🌧️", 66: "🌧️", 67: "🌧️", 71: "❄️", 73: "❄️", 75: "❄️", 77: "❄️", 80: "🌦️",
        81: "🌦️", 82: "🌧️", 85: "🌨️", 86: "🌨️", 95: "⛈️", 96: "⛈️", 99: "⛈️"}
TEXT = {0: "Clear sky", 1: "Mostly clear", 2: "Partly cloudy", 3: "Cloudy", 45: "Fog", 48: "Fog", 51: "Light drizzle", 53: "Drizzle",
        55: "Heavy drizzle", 61: "Light rain", 63: "Rain", 65: "Heavy rain", 71: "Light snow", 73: "Snow", 75: "Heavy snow",
        80: "Rain showers", 81: "Rain showers", 82: "Heavy showers", 95: "Thunderstorm", 96: "Thunderstorm", 99: "Thunderstorm"}
CSS = b"""
window { background-color: #0a111c; }
.card { background-color: #0e1a2b; border-radius: 16px; border: 1px solid #1d3347; padding: 16px; }
.bigtime { font-size: 46px; font-weight: 200; color: #ecf4fa; }
.date { font-size: 14px; color: #9fb3c8; }
.head { font-size: 12px; font-weight: 700; color: #96ebcd; letter-spacing: 1px; }
.temp { font-size: 44px; font-weight: 300; color: #ffffff; }
.city { font-size: 15px; font-weight: 700; color: #ecf4fa; }
.muted { font-size: 12px; color: #9fb3c8; }
.day { font-size: 12px; color: #d6e2ee; }
.news { background: none; border: none; box-shadow: none; padding: 8px 4px; color: #ecf4fa; }
.news:hover { background-color: #17283d; border-radius: 10px; }
.src { font-size: 11px; color: #96ebcd; }
entry { min-height: 34px; border-radius: 10px; background-color: #17283d; border: 1px solid #3a5a74; color: #ffffff; padding: 0 10px; }
button.act { background-image: none; background-color: #14968a; color: #fff; border-radius: 10px; border: none; min-height: 32px; }
calendar { background-color: #0e1a2b; color: #ecf4fa; border: none; padding: 4px; }
calendar:selected { background-color: #14968a; color: #ffffff; border-radius: 8px; }
calendar:indeterminate { color: #4a6075; }
calendar.header { color: #96ebcd; }
calendar.button { color: #96ebcd; }
button.link { background: none; border: none; box-shadow: none; color: #96ebcd; }
"""

def load_cfg():
    c = {"city": "", "lat": None, "lon": None, "fahrenheit": False, "feeds": FEEDS}
    try: c.update(json.load(open(CFG)))
    except Exception: pass
    return c
def save_cfg(c):
    os.makedirs(os.path.dirname(CFG), exist_ok=True); json.dump(c, open(CFG, "w"))
def fetch(url, timeout=9):
    req = urllib.request.Request(url, headers={"User-Agent": "HEX-OS-Widgets/1.0"})
    return urllib.request.urlopen(req, timeout=timeout).read()
def weather_url(c):
    return ("https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s"
            "&current=temperature_2m,apparent_temperature,relative_humidity_2m,weather_code,wind_speed_10m"
            "&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=6&temperature_unit=%s"
            % (c["lat"], c["lon"], "fahrenheit" if c["fahrenheit"] else "celsius"))
def get_weather(c, force=False):
    if c.get("lat") is None: return None
    try:
        if not force and time.time() - os.path.getmtime(CACHE) < 900: return json.load(open(CACHE))
    except Exception: pass
    data = json.loads(fetch(weather_url(c)))
    os.makedirs(os.path.dirname(CACHE), exist_ok=True); json.dump(data, open(CACHE, "w"))
    return data
def get_news(c):
    items = []
    for name, url in c["feeds"]:
        try:
            root = ET.fromstring(fetch(url))
            for it in root.iter("item"):
                t = (it.findtext("title") or "").strip(); l = (it.findtext("link") or "").strip()
                if not t or not l: continue
                try: ts = parsedate_to_datetime(it.findtext("pubDate")).timestamp()
                except Exception: ts = 0
                items.append((ts, name, t, l))
        except Exception: pass
    items.sort(reverse=True)
    out, per = [], {}
    for ts, name, t, l in items:
        if per.get(name, 0) >= 5: continue
        per[name] = per.get(name, 0) + 1; out.append((ts, name, t, l))
    return sorted(out, reverse=True)[:12]
def ago(ts):
    if not ts: return ""
    m = int((time.time() - ts) / 60)
    return "%dm ago" % m if m < 60 else ("%dh ago" % (m // 60) if m < 1440 else "%dd ago" % (m // 1440))

class Widgets(Gtk.Window):
    def __init__(self):
        super().__init__(title="HEX Widgets")
        self.cfg = load_cfg(); self.shown_at = time.time(); self.closing = False
        self.set_decorated(False); self.set_skip_taskbar_hint(True); self.set_type_hint(Gdk.WindowTypeHint.DIALOG); self.set_keep_above(True)
        mon = Gdk.Display.get_default().get_primary_monitor() or Gdk.Display.get_default().get_monitor(0)
        wa = mon.get_workarea()
        self.w, self.h = 430, min(760, wa.height - 16)
        self.set_default_size(self.w, self.h); self.set_resizable(False)
        self.tx, self.ty = wa.x + 8, wa.y + wa.height - self.h - 8
        self.sx = wa.x - self.w
        sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC); self.add(sc)
        self.col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12); self.col.set_border_width(14); sc.add(self.col)
        # clock
        self.time_l = Gtk.Label(); self.time_l.set_xalign(0); self.time_l.get_style_context().add_class("bigtime")
        self.date_l = Gtk.Label(); self.date_l.set_xalign(0); self.date_l.get_style_context().add_class("date")
        self.col.pack_start(self.time_l, False, False, 0); self.col.pack_start(self.date_l, False, False, 0)
        self.wbox = self.card("WEATHER"); self.cal = self.card("CALENDAR"); self.nbox = self.card("NEWS")
        c = Gtk.Calendar(); self.cal.pack_start(c, False, False, 0)
        self.tick(); GLib.timeout_add_seconds(5, self.tick)
        self.connect("key-press-event", lambda w, e: self.close_now() if e.keyval == Gdk.KEY_Escape else None)
        self.connect("focus-out-event", self.on_focus_out)
        self.connect("destroy", lambda *_: (open(CLOSED, "w").write(str(time.time())), Gtk.main_quit()))
        self.move(self.sx, self.ty); self.show_all(); self.present()
        self.step = 0; GLib.timeout_add(14, self.slide)
        self.render_weather(); self.load_news()
    def card(self, title):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8); box.get_style_context().add_class("card")
        h = Gtk.Label(label=title); h.set_xalign(0); h.get_style_context().add_class("head"); box.pack_start(h, False, False, 0)
        self.col.pack_start(box, False, False, 0); return box
    def slide(self):
        self.step += 1; k = min(1.0, self.step / 14.0); e = 1 - (1 - k) ** 3
        self.move(int(self.sx + (self.tx - self.sx) * e), self.ty)
        return k < 1.0
    def on_focus_out(self, *_):
        if time.time() - self.shown_at > 0.8: GLib.timeout_add(120, self.close_now)
    def close_now(self):
        if not self.closing: self.closing = True; self.destroy()
        return False
    def tick(self):
        self.time_l.set_text(time.strftime("%H:%M")); self.date_l.set_text(time.strftime("%A, %d %B")); return True
    def clear(self, box):
        for ch in box.get_children()[1:]: box.remove(ch)
    # ---- weather ----
    def render_weather(self):
        self.clear(self.wbox)
        if self.cfg.get("lat") is None:
            l = Gtk.Label(label="Where are you? Weather updates come from open-meteo.com (free, no account)."); l.set_line_wrap(True); l.set_xalign(0); l.get_style_context().add_class("muted")
            e = Gtk.Entry(); e.set_placeholder_text("Your city, e.g. Hyderabad")
            b = Gtk.Button(label="Show my weather"); b.get_style_context().add_class("act")
            self.msg = Gtk.Label(); self.msg.set_xalign(0); self.msg.get_style_context().add_class("muted")
            def go(*_): self.find_city(e.get_text().strip())
            e.connect("activate", go); b.connect("clicked", go)
            for w in (l, e, b, self.msg): self.wbox.pack_start(w, False, False, 0)
            self.wbox.show_all(); return
        l = Gtk.Label(label="Loading weather…"); l.set_xalign(0); l.get_style_context().add_class("muted"); self.wbox.pack_start(l, False, False, 0); self.wbox.show_all()
        def work():
            try: d = get_weather(self.cfg); GLib.idle_add(self.show_weather, d)
            except Exception: GLib.idle_add(self.weather_error)
        threading.Thread(target=work, daemon=True).start()
    def weather_error(self):
        self.clear(self.wbox)
        l = Gtk.Label(label="Could not load the weather. Check your internet connection."); l.set_line_wrap(True); l.set_xalign(0); l.get_style_context().add_class("muted")
        b = Gtk.Button(label="Try again"); b.get_style_context().add_class("link"); b.connect("clicked", lambda *_: self.render_weather())
        c = Gtk.Button(label="Change city"); c.get_style_context().add_class("link"); c.connect("clicked", self.change_city)
        for w in (l, b, c): self.wbox.pack_start(w, False, False, 0)
        self.wbox.show_all()
    def show_weather(self, d):
        self.clear(self.wbox)
        cur, day = d["current"], d["daily"]; u = "°F" if self.cfg["fahrenheit"] else "°C"; code = cur["weather_code"]
        city = Gtk.Label(label=self.cfg["city"]); city.set_xalign(0); city.get_style_context().add_class("city")
        t = Gtk.Label(label="%s  %d%s" % (ICON.get(code, "🌡️"), round(cur["temperature_2m"]), u)); t.set_xalign(0); t.get_style_context().add_class("temp")
        desc = Gtk.Label(label="%s · feels like %d%s · humidity %d%% · wind %d km/h" % (TEXT.get(code, ""), round(cur["apparent_temperature"]), u, cur["relative_humidity_2m"], round(cur["wind_speed_10m"])))
        desc.set_xalign(0); desc.set_line_wrap(True); desc.get_style_context().add_class("muted")
        row = Gtk.Box(spacing=6, homogeneous=True)
        for i in range(1, 6):
            try: name = time.strftime("%a", time.strptime(day["time"][i], "%Y-%m-%d"))
            except Exception: name = ""
            lab = Gtk.Label(label="%s\n%s\n%d° / %d°" % (name, ICON.get(day["weather_code"][i], ""), round(day["temperature_2m_max"][i]), round(day["temperature_2m_min"][i])))
            lab.set_justify(Gtk.Justification.CENTER); lab.get_style_context().add_class("day"); row.pack_start(lab, True, True, 0)
        act = Gtk.Box(spacing=6)
        b1 = Gtk.Button(label="°C / °F"); b1.get_style_context().add_class("link"); b1.connect("clicked", self.toggle_unit)
        b2 = Gtk.Button(label="Change city"); b2.get_style_context().add_class("link"); b2.connect("clicked", self.change_city)
        act.pack_start(b1, False, False, 0); act.pack_start(b2, False, False, 0)
        for w in (city, t, desc, row, act): self.wbox.pack_start(w, False, False, 0)
        self.wbox.show_all()
    def toggle_unit(self, *_):
        self.cfg["fahrenheit"] = not self.cfg["fahrenheit"]; save_cfg(self.cfg)
        try: os.remove(CACHE)
        except OSError: pass
        self.render_weather()
    def change_city(self, *_):
        self.cfg["lat"] = None; save_cfg(self.cfg); self.render_weather()
    def find_city(self, name):
        if not name: return
        self.msg.set_text("Searching…")
        def work():
            try:
                r = json.loads(fetch("https://geocoding-api.open-meteo.com/v1/search?count=1&language=en&format=json&name=" + urllib.parse.quote(name)))["results"][0]
                self.cfg.update({"city": "%s, %s" % (r["name"], r.get("country", "")), "lat": r["latitude"], "lon": r["longitude"]}); save_cfg(self.cfg)
                try: os.remove(CACHE)
                except OSError: pass
                GLib.idle_add(self.render_weather)
            except Exception: GLib.idle_add(self.msg.set_text, "City not found, or no internet.")
        threading.Thread(target=work, daemon=True).start()
    # ---- news ----
    def load_news(self):
        self.clear(self.nbox)
        l = Gtk.Label(label="Loading headlines…"); l.set_xalign(0); l.get_style_context().add_class("muted"); self.nbox.pack_start(l, False, False, 0); self.nbox.show_all()
        def work(): GLib.idle_add(self.show_news, get_news(self.cfg))
        threading.Thread(target=work, daemon=True).start()
    def show_news(self, items):
        self.clear(self.nbox)
        if not items:
            l = Gtk.Label(label="Could not load the news. Check your internet connection."); l.set_xalign(0); l.set_line_wrap(True); l.get_style_context().add_class("muted"); self.nbox.pack_start(l, False, False, 0)
        for ts, name, title, link in items:
            b = Gtk.Button(); b.get_style_context().add_class("news")
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            s = Gtk.Label(label=("%s · %s" % (name, ago(ts))).strip(" ·")); s.set_xalign(0); s.get_style_context().add_class("src")
            t = Gtk.Label(label=title); t.set_xalign(0); t.set_line_wrap(True); t.set_max_width_chars(44)
            v.pack_start(s, False, False, 0); v.pack_start(t, False, False, 0); b.add(v)
            b.connect("clicked", lambda _b, u=link: (subprocess.Popen(["xdg-open", u], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL), self.close_now()))
            self.nbox.pack_start(b, False, False, 0)
        r = Gtk.Button(label="Refresh"); r.get_style_context().add_class("link"); r.connect("clicked", lambda *_: self.load_news()); self.nbox.pack_start(r, False, False, 0)
        self.nbox.show_all()

def main():
    prov = Gtk.CssProvider(); prov.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    Widgets(); Gtk.main()

if __name__ == "__main__":
    main()
