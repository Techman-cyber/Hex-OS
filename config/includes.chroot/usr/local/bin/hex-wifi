#!/usr/bin/python3
"""HEX Wi-Fi: see nearby networks, connect with a password, switch Wi-Fi on or off."""
import subprocess, threading
import gi
gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib

CSS = b"""
window { background-color: #0a111c; }
.title { font-size: 22px; font-weight: 700; color: #ecf4fa; }
.status { font-size: 13px; color: #9fb3c8; }
.net { background-image: none; background-color: #17283d; border: 1px solid #2a4a5e; border-radius: 12px; padding: 10px 14px; color: #ecf4fa; }
.net:hover { background-color: #1f3a55; }
.net.on { border-color: #19b0a1; background-color: #17405a; }
.ssid { font-size: 14px; font-weight: 700; }
.meta { font-size: 11px; color: #9fb3c8; }
.empty { font-size: 14px; color: #c5d4e3; }
button.act { background-image: none; background-color: #14968a; color: #fff; border-radius: 12px; border: none; min-height: 36px; padding: 0 16px; font-weight: 700; }
button.ghost { background-image: none; background-color: rgba(255,255,255,0.08); color: #ecf4fa; border-radius: 12px; border: none; min-height: 36px; padding: 0 14px; }
entry { min-height: 38px; border-radius: 10px; background-color: #17283d; border: 1px solid #3a5a74; color: #fff; padding: 0 10px; }
"""

def sh(cmd, timeout=25):
    try: return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except Exception: return None

def split_terse(line):
    out, cur, esc = [], "", False
    for ch in line:
        if esc: cur += ch; esc = False
        elif ch == "\\": esc = True
        elif ch == ":": out.append(cur); cur = ""
        else: cur += ch
    out.append(cur); return out

def bars(sig):
    s = int(sig or 0); return "▂▄▆█"[:max(1, min(4, (s + 24) // 25))].ljust(4, "·")

class Wifi(Gtk.Window):
    def __init__(self):
        super().__init__(title="Wi-Fi"); self.set_default_size(440, 580); self.set_position(Gtk.WindowPosition.CENTER)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12); root.set_border_width(18); self.add(root)
        head = Gtk.Box(spacing=10); root.pack_start(head, False, False, 0)
        t = Gtk.Label(label="Wi-Fi"); t.get_style_context().add_class("title"); head.pack_start(t, False, False, 0)
        self.sw = Gtk.Switch(); self.sw.set_valign(Gtk.Align.CENTER); self.sw.connect("state-set", self.on_switch); head.pack_end(self.sw, False, False, 0)
        rf = Gtk.Button(label="Refresh"); rf.get_style_context().add_class("ghost"); rf.connect("clicked", lambda *_: self.refresh(True)); head.pack_end(rf, False, False, 6)
        self.status = Gtk.Label(); self.status.set_xalign(0); self.status.set_line_wrap(True); self.status.get_style_context().add_class("status"); root.pack_start(self.status, False, False, 0)
        sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC); root.pack_start(sc, True, True, 0)
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8); sc.add(self.list)
        more = Gtk.Button(label="Advanced network settings"); more.get_style_context().add_class("ghost"); more.connect("clicked", lambda *_: subprocess.Popen(["nm-connection-editor"])); root.pack_start(more, False, False, 0)
        self.has_wifi = True; self.show_all(); self.refresh(False)

    def clear(self):
        for c in self.list.get_children(): self.list.remove(c)
    def refresh(self, rescan):
        self.status.set_text("Looking for networks..."); threading.Thread(target=self.work, args=(rescan,), daemon=True).start()
    def work(self, rescan):
        dev = sh(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device"]); lines = dev.stdout.strip().splitlines() if dev else []
        wired = [split_terse(l) for l in lines if ":ethernet:" in l]; wifi = [split_terse(l) for l in lines if ":wifi:" in l]
        nets = []
        if wifi:
            r = sh(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi", "list", "--rescan", "yes" if rescan else "auto"])
            if r:
                seen = set()
                for l in r.stdout.strip().splitlines():
                    p = split_terse(l)
                    if len(p) >= 4 and p[1] and p[1] not in seen: seen.add(p[1]); nets.append(p)
        on = (sh(["nmcli", "radio", "wifi"]) or None)
        GLib.idle_add(self.show, bool(wifi), (on.stdout.strip() == "enabled") if on else False, nets, wired)
    def show(self, has_wifi, enabled, nets, wired):
        self.has_wifi = has_wifi; self.clear()
        self.sw.set_sensitive(has_wifi); self.sw.handler_block_by_func(self.on_switch); self.sw.set_active(enabled and has_wifi); self.sw.handler_unblock_by_func(self.on_switch)
        wtxt = ("Wired: connected" if any(w[2] == "connected" for w in wired) else "Wired: not connected") if wired else ""
        if not has_wifi:
            self.status.set_text(wtxt)
            e = Gtk.Label(label="No Wi-Fi adapter found.\n\nA virtual machine (like VirtualBox) only has a wired connection, which is why you see Ethernet.\nOn a real computer, or with a USB Wi-Fi adapter, your networks will appear here.")
            e.set_line_wrap(True); e.set_justify(Gtk.Justification.CENTER); e.get_style_context().add_class("empty"); e.set_margin_top(40); self.list.pack_start(e, False, False, 0)
        elif not enabled:
            self.status.set_text("Wi-Fi is off. Turn it on with the switch."); 
        else:
            cur = [n for n in nets if n[0] == "*"]
            self.status.set_text(("Connected to %s.  " % cur[0][1] if cur else "Not connected.  ") + wtxt)
            if not nets:
                e = Gtk.Label(label="No networks found. Press Refresh."); e.get_style_context().add_class("empty"); e.set_margin_top(30); self.list.pack_start(e, False, False, 0)
            for n in sorted(nets, key=lambda x: (x[0] != "*", -int(x[2] or 0))):
                b = Gtk.Button(); b.set_relief(Gtk.ReliefStyle.NONE); b.get_style_context().add_class("net")
                if n[0] == "*": b.get_style_context().add_class("on")
                row = Gtk.Box(spacing=12); v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                s = Gtk.Label(label=n[1]); s.set_xalign(0); s.get_style_context().add_class("ssid"); v.pack_start(s, False, False, 0)
                m = Gtk.Label(label=("Connected" if n[0] == "*" else ("Secured" if n[3] else "Open")) + "  ·  " + (n[3] or "no password")); m.set_xalign(0); m.get_style_context().add_class("meta"); v.pack_start(m, False, False, 0)
                row.pack_start(v, True, True, 0)
                sg = Gtk.Label(label=("🔒 " if n[3] else "") + bars(n[2])); row.pack_end(sg, False, False, 0); b.add(row)
                b.connect("clicked", lambda _b, net=n: self.connect_to(net)); self.list.pack_start(b, False, False, 0)
        self.list.show_all(); return False
    def on_switch(self, sw, state):
        sh(["nmcli", "radio", "wifi", "on" if state else "off"]); GLib.timeout_add(1200, lambda: (self.refresh(True), False)[1]); return False
    def connect_to(self, net):
        if net[0] == "*": return
        cmd = ["nmcli", "device", "wifi", "connect", net[1]]
        if net[3]:
            d = Gtk.Dialog(title="Connect to %s" % net[1], transient_for=self, modal=True)
            d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Connect", Gtk.ResponseType.OK); d.set_default_response(Gtk.ResponseType.OK)
            box = d.get_content_area(); box.set_border_width(16); box.set_spacing(10)
            box.pack_start(Gtk.Label(label="Password for %s" % net[1]), False, False, 0)
            e = Gtk.Entry(); e.set_visibility(False); e.set_activates_default(True); box.pack_start(e, False, False, 0)
            d.show_all(); r = d.run(); pw = e.get_text(); d.destroy()
            if r != Gtk.ResponseType.OK: return
            if pw: cmd += ["password", pw]
        self.status.set_text("Connecting to %s..." % net[1])
        def go():
            r = sh(cmd, 45); ok = bool(r and r.returncode == 0)
            GLib.idle_add(lambda: (self.status.set_text("Connected." if ok else "Could not connect. Check the password and try again."), self.refresh(False), False)[2])
        threading.Thread(target=go, daemon=True).start()

def main():
    p = Gtk.CssProvider(); p.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    w = Wifi(); w.connect("destroy", Gtk.main_quit); Gtk.main()

if __name__ == "__main__":
    main()
