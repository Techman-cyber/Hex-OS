#!/usr/bin/env bash
# Taskbar weather text (used by the panel's generic monitor). Needs a city set in the Widgets panel.
CFG="$HOME/.config/hex-widgets.json"; CACHE="$HOME/.cache/hex-weather.json"
emoji() { case "$1" in 0) echo "☀️";; 1) echo "🌤️";; 2) echo "⛅";; 3) echo "☁️";; 45|48) echo "🌫️";; 5[1-7]|8[0-1]) echo "🌦️";; 6[1-7]|82) echo "🌧️";; 7[1-7]|8[56]) echo "❄️";; 9[5-9]) echo "⛈️";; *) echo "🌡️";; esac; }
click="<txtclick>bash /usr/local/bin/hex-widgets-toggle</txtclick>"
lat=$(jq -r '.lat // empty' "$CFG" 2>/dev/null); lon=$(jq -r '.lon // empty' "$CFG" 2>/dev/null)
if [ -z "$lat" ]; then echo "<txt>🌡️ Set city</txt><tool>Click to open Widgets and choose your city</tool>$click"; exit 0; fi
if [ ! -f "$CACHE" ] || [ $(( $(date +%s) - $(stat -c %Y "$CACHE") )) -gt 900 ]; then
  f=$(jq -r 'if .fahrenheit then "fahrenheit" else "celsius" end' "$CFG")
  curl -s -m 8 "https://api.open-meteo.com/v1/forecast?latitude=$lat&longitude=$lon&current=temperature_2m,apparent_temperature,relative_humidity_2m,weather_code,wind_speed_10m&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=6&temperature_unit=$f" -o "$CACHE.new" && jq -e .current "$CACHE.new" >/dev/null 2>&1 && mv "$CACHE.new" "$CACHE"
fi
t=$(jq -r '.current.temperature_2m | round' "$CACHE" 2>/dev/null); c=$(jq -r '.current.weather_code' "$CACHE" 2>/dev/null)
u="°C"; [ "$(jq -r '.fahrenheit' "$CFG")" = "true" ] && u="°F"
city=$(jq -r '.city' "$CFG")
if [ -z "$t" ] || [ "$t" = "null" ]; then echo "<txt>🌡️ --</txt><tool>Weather unavailable. Check your internet connection.</tool>$click"; exit 0; fi
echo "<txt>$(emoji "$c") $t$u</txt><tool>$city - click for weather, calendar and news</tool>$click"
