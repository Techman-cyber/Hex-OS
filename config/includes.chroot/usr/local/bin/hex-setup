#!/usr/bin/env bash
# Runs once after first login: wallpaper, dock settings, Flathub, welcome window.
M="$HOME/.config/hex-setup-done"; [ -f "$M" ] && exit 0
sleep 4
WP=/usr/share/backgrounds/hex/hex-wallpaper.jpg
# Wallpaper: update every monitor/workspace entry that exists, and create entries for connected outputs
xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'last-image$' | while read -r p; do xfconf-query -c xfce4-desktop -p "$p" -s "$WP"; done
for o in 0 $(xrandr --query 2>/dev/null | awk '/ connected/{print $1}'); do
  b="/backdrop/screen0/monitor$o/workspace0"
  xfconf-query -c xfce4-desktop -p "$b/last-image" -n -t string -s "$WP" 2>/dev/null || xfconf-query -c xfce4-desktop -p "$b/last-image" -s "$WP"
  xfconf-query -c xfce4-desktop -p "$b/image-style" -n -t int -s 5 2>/dev/null || xfconf-query -c xfce4-desktop -p "$b/image-style" -s 5
done
D="net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/"
gsettings set "$D" zoom-enabled true
gsettings set "$D" zoom-percent 220
gsettings set "$D" icon-size 52
gsettings set "$D" theme 'Transparent'
gsettings set "$D" hide-mode 'intelligent'
pkill plank 2>/dev/null; (nohup plank >/dev/null 2>&1 &)
(flatpak remote-add --if-not-exists --user flathub https://flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1 &)
touch "$M"
bash /usr/local/bin/hex-welcome &
