#!/usr/bin/env bash
# hex-fx: window effects and transitions.
#   smooth = windows fade in and out, soft shadows (safe everywhere)
#   glass  = smooth + blur (needs a real graphics card)
#   off    = plain
# Usage: hex-fx auto | smooth | glass | off | status
CONF="$HOME/.config/hex-fx"
mode() { [ -f "$CONF" ] && cat "$CONF" || echo auto; }
is_vm() { systemd-detect-virt -q 2>/dev/null; }
xfwm() { xfconf-query -c xfwm4 -p /general/use_compositing -n -t bool -s "$1" 2>/dev/null; }
stop_fx() { pkill -x picom 2>/dev/null; xfwm true; }
start_picom() {   # $1 = config file
  xfwm false; pkill -x picom 2>/dev/null; sleep 0.3
  picom --config "$1" -b 2>/dev/null; sleep 1.2
  pgrep -x picom >/dev/null || { xfwm true; return 1; }
}
LITE="$HOME/.config/picom/picom-lite.conf"; FULL="$HOME/.config/picom/picom.conf"
case "${1:-auto}" in
  smooth) echo smooth > "$CONF"; start_picom "$LITE" ;;
  glass) echo glass > "$CONF"; start_picom "$FULL" || start_picom "$LITE" ;;
  off) echo off > "$CONF"; stop_fx ;;
  status) if pgrep -x picom >/dev/null; then echo "effects: $(mode) (running)"; else echo "effects: off"; fi ;;
  *)
    is_vm && xfconf-query -c xfwm4 -p /general/vblank_mode -n -t string -s off 2>/dev/null
    case "$(mode)" in
      smooth) start_picom "$LITE" ;;
      glass) start_picom "$FULL" || start_picom "$LITE" ;;
      off) stop_fx ;;
      *) if is_vm; then start_picom "$LITE"; else start_picom "$FULL" || start_picom "$LITE"; fi ;;
    esac ;;
esac
exit 0
