#!/usr/bin/python3
"""HEX login screen: big clock, user card, password, session, power, and Create account."""
import os, subprocess, time
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("LightDM", "1")
from gi.repository import Gtk, Gdk, GLib, LightDM

LIVE = os.path.isdir("/run/live")
CSS = b"""
window { background-image: url('file:///usr/share/backgrounds/hex/hex-wallpaper-blur-plain.jpg'); background-size: cover; background-position: center; }
.bigclock { font-size: 84px; font-weight: 200; color: #f2f7fb; }
.bigdate { font-size: 20px; color: #c5d4e3; }
.card { background-color: #0e1a2b; border-radius: 24px; border: 1px solid #2a4a5e; padding: 26px 32px; }
.avatar { min-width: 92px; min-height: 92px; border-radius: 46px; background-color: #14968a; color: #ffffff; font-size: 42px; font-weight: 700; }
.name { font-size: 20px; font-weight: 700; color: #ecf4fa; }
.sub { color: #9fb3c8; font-size: 13px; }
.hint { color: #96ebcd; font-size: 13px; }
.err { color: #ff9e94; font-size: 13px; }
.ok { color: #96ebcd; font-size: 13px; }
.bar { background-color: rgba(8,14,24,0.85); padding: 8px 16px; color: #d6e2ee; }
entry { min-height: 42px; border-radius: 12px; background-color: #17283d; border: 1px solid #3a5a74; color: #ffffff; padding: 0 12px; }
combobox button { min-height: 36px; border-radius: 10px; }
button.primary { background-image: none; background-color: #14968a; color: #ffffff; border-radius: 12px; min-height: 42px; border: none; font-weight: 700; }
button.primary:hover { background-color: #19b0a1; }
button.link { background: none; border: none; color: #96ebcd; box-shadow: none; }
button.barbtn { background: none; border: none; color: #d6e2ee; box-shadow: none; }
button.barbtn:hover { background-color: #17283d; border-radius: 8px; }
"""

class Greeter(Gtk.Window):
    def __init__(self):
        super().__init__()
        self.greeter = LightDM.Greeter()
        self.greeter.connect("show-prompt", self.on_prompt)
        self.greeter.connect("show-message", self.on_message)
        self.greeter.connect("authentication-complete", self.on_done)
        if not self.greeter.connect_to_daemon_sync():
            raise SystemExit(1)
        self.pw = ""
        self.user_names, self.user_display = [], {}
        self.set_decorated(False)
        scr = Gdk.Screen.get_default()
        self.set_default_size(scr.get_width(), scr.get_height()); self.move(0, 0)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); self.add(root)
        top = Gtk.Box(); top.get_style_context().add_class("bar")
        top.pack_start(Gtk.Label(label=GLib.get_host_name()), False, False, 0)
        root.pack_start(top, False, False, 0)

        centre = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        centre.set_halign(Gtk.Align.CENTER); centre.set_valign(Gtk.Align.CENTER)
        root.pack_start(centre, True, True, 0)
        self.clock = Gtk.Label(); self.clock.get_style_context().add_class("bigclock"); centre.pack_start(self.clock, False, False, 0)
        self.date = Gtk.Label(); self.date.get_style_context().add_class("bigdate"); centre.pack_start(self.date, False, False, 14)

        self.reveal = Gtk.Revealer(); self.reveal.set_transition_type(Gtk.RevealerTransitionType.SLIDE_UP); self.reveal.set_transition_duration(750)
        centre.pack_start(self.reveal, False, False, 0)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12); card.get_style_context().add_class("card"); card.set_size_request(390, -1)
        self.reveal.add(card)

        self.avatar = Gtk.Label(); self.avatar.get_style_context().add_class("avatar"); self.avatar.set_halign(Gtk.Align.CENTER)
        card.pack_start(self.avatar, False, False, 0)
        self.name = Gtk.Label(); self.name.get_style_context().add_class("name"); card.pack_start(self.name, False, False, 0)
        self.stack = Gtk.Stack(); self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(300); self.stack.set_interpolate_size(True); self.stack.set_homogeneous(False)
        card.pack_start(self.stack, False, False, 0)
        self.msg = Gtk.Label(); self.msg.set_line_wrap(True); self.msg.set_max_width_chars(40); card.pack_start(self.msg, False, False, 0)

        # login page
        lp = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.users = Gtk.ComboBoxText(); self.users.connect("changed", self.on_user_changed); lp.pack_start(self.users, False, False, 0)
        self.entry = Gtk.Entry(); self.entry.set_visibility(False); self.entry.set_placeholder_text("Password")
        self.entry.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, "view-reveal-symbolic")
        self.entry.connect("icon-press", lambda e, *_: e.set_visibility(not e.get_visibility()))
        self.entry.connect("activate", self.do_login); lp.pack_start(self.entry, False, False, 0)
        self.login_btn = Gtk.Button(label="Log in"); self.login_btn.get_style_context().add_class("primary"); self.login_btn.connect("clicked", self.do_login)
        lp.pack_start(self.login_btn, False, False, 0)
        su = Gtk.Button(label="Create a new account"); su.get_style_context().add_class("link"); su.connect("clicked", lambda *_: self.show_page("signup"))
        lp.pack_start(su, False, False, 0)
        hint = Gtk.Label(); hint.set_line_wrap(True); hint.set_max_width_chars(40); hint.get_style_context().add_class("hint")
        hint.set_text("Live session.  Username: user    Password: live" if LIVE else
                      "Forgot your password? Boot the HEX USB, then Welcome > Reset a forgotten password.")
        lp.pack_start(hint, False, False, 0)
        self.stack.add_named(lp, "login")

        # sign-up page (inline: works without a window manager)
        sp = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        def field(ph, secret=False):
            e = Gtk.Entry(); e.set_placeholder_text(ph); e.set_visibility(not secret); sp.pack_start(e, False, False, 0); return e
        self.f_user = field("New username (lowercase)")
        self.f_name = field("Full name (optional)")
        self.f_pw1 = field("New password", True)
        self.f_pw2 = field("Repeat the new password", True)
        a = Gtk.Label(label="An administrator must approve new accounts:"); a.get_style_context().add_class("sub"); a.set_xalign(0)
        sp.pack_start(a, False, False, 0)
        self.f_admin = field("Administrator username")
        self.f_apw = field("Administrator password", True); self.f_apw.connect("activate", self.do_signup)
        row = Gtk.Box(spacing=8)
        back = Gtk.Button(label="Back"); back.get_style_context().add_class("link"); back.connect("clicked", lambda *_: self.show_page("login"))
        ok = Gtk.Button(label="Create account"); ok.get_style_context().add_class("primary"); ok.connect("clicked", self.do_signup)
        row.pack_start(back, False, False, 0); row.pack_end(ok, True, True, 0)
        sp.pack_start(row, False, False, 0)
        self.stack.add_named(sp, "signup")

        bar = Gtk.Box(spacing=10); bar.get_style_context().add_class("bar")
        self.sessions = Gtk.ComboBoxText(); self.session_keys = []
        for s in LightDM.get_sessions():
            self.sessions.append_text(s.get_name()); self.session_keys.append(s.get_key())
        if self.session_keys: self.sessions.set_active(self.session_keys.index("xfce") if "xfce" in self.session_keys else 0)
        bar.pack_start(self.sessions, False, False, 0)
        for label, can, fn in (("Shut down", LightDM.get_can_shutdown, LightDM.shutdown), ("Restart", LightDM.get_can_restart, LightDM.restart)):
            btn = Gtk.Button(label=label); btn.get_style_context().add_class("barbtn")
            btn.connect("clicked", lambda _b, f=fn: f()); btn.set_sensitive(bool(can())); bar.pack_end(btn, False, False, 0)
        root.pack_end(bar, False, False, 0)

        for u in LightDM.UserList.get_instance().get_users():
            self.add_user(u.get_name(), u.get_display_name() or u.get_name())
        if self.user_names: self.users.set_active(0)
        self.tick(); GLib.timeout_add_seconds(1, self.tick)
        GLib.timeout_add(250, lambda: (self.reveal.set_reveal_child(True), False)[1])

    def add_user(self, name, display):
        if name in self.user_names: return
        self.user_names.append(name); self.user_display[name] = display
        self.users.append_text(display if display == name else "%s (%s)" % (display, name))
    def on_user_changed(self, *_):
        i = self.users.get_active()
        if 0 <= i < len(self.user_names):
            d = self.user_display[self.user_names[i]]
            self.avatar.set_text((d[:1] or "?").upper()); self.name.set_text(d)
    def show_page(self, page):
        self.set_msg(""); self.stack.set_visible_child_name(page)
        login = page == "login"
        for w in (self.clock, self.date, self.avatar, self.name): w.set_visible(login)
        (self.entry if page == "login" else self.f_user).grab_focus()
    def set_msg(self, text, kind="err"):
        ctx = self.msg.get_style_context()
        for c in ("err", "ok"): ctx.remove_class(c)
        ctx.add_class(kind); self.msg.set_text(text)
    def tick(self, *_):
        self.clock.set_text(time.strftime("%H:%M")); self.date.set_text(time.strftime("%A, %d %B")); return True

    def do_login(self, *_):
        i = self.users.get_active()
        if i < 0 or i >= len(self.user_names): return
        self.pw = self.entry.get_text(); self.set_msg("Signing in...", "ok"); self.login_btn.set_sensitive(False)
        if self.greeter.get_in_authentication(): self.greeter.cancel_authentication()
        self.greeter.authenticate(self.user_names[i])
    def on_prompt(self, g, text, ptype):
        g.respond(self.pw)
    def on_message(self, g, text, mtype):
        if text: self.set_msg(text)
    def on_done(self, g):
        if g.get_is_authenticated():
            self.set_msg("Welcome!", "ok")
            i = self.sessions.get_active()
            key = self.session_keys[i] if 0 <= i < len(self.session_keys) else "xfce"
            if not g.start_session_sync(key): self.set_msg("Could not start the session."); self.login_btn.set_sensitive(True)
        else:
            self.set_msg("Wrong password. Please try again."); self.login_btn.set_sensitive(True)
            self.entry.set_text(""); self.entry.grab_focus()

    def do_signup(self, *_):
        u, n = self.f_user.get_text().strip(), self.f_name.get_text().strip()
        p1, p2 = self.f_pw1.get_text(), self.f_pw2.get_text()
        a, ap = self.f_admin.get_text().strip(), self.f_apw.get_text()
        if not u or not p1 or not a or not ap: return self.set_msg("Please fill in every field except the full name.")
        if p1 != p2: return self.set_msg("The two new passwords do not match.")
        self.set_msg("Creating the account...", "ok")
        try:
            r = subprocess.run(["sudo", "-n", "/usr/local/sbin/hex-signup-helper"], input="\n".join([u, n, p1, a, ap]) + "\n",
                               capture_output=True, text=True, timeout=40)
            out = r.stdout.strip()
        except Exception:
            out = ""
        if out.startswith("OK"):
            self.add_user(u, n or u); self.users.set_active(self.user_names.index(u))
            for e in (self.f_user, self.f_name, self.f_pw1, self.f_pw2, self.f_admin, self.f_apw): e.set_text("")
            self.show_page("login"); self.set_msg("Account '%s' is ready. Enter its password to log in." % u, "ok")
        else:
            self.set_msg(out[4:] if out.startswith("ERR ") else "Could not create the account.")

def main():
    prov = Gtk.CssProvider(); prov.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    st = Gtk.Settings.get_default()
    for k, v in (("gtk-theme-name", "Arc-Dark"), ("gtk-icon-theme-name", "Papirus-Dark"), ("gtk-font-name", "Inter 11"), ("gtk-cursor-theme-name", "HEX-Cursor")):
        try: st.set_property(k, v)
        except Exception: pass
    w = Greeter(); w.show_all(); w.entry.grab_focus(); Gtk.main()

if __name__ == "__main__":
    main()
