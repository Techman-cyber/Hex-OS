#!/usr/bin/env bash
# Plays the HEX goodbye sound for log out / restart / shut down, then hands over to the real command.
for a in "$@"; do
  case "$a" in
    --logout|--halt|--reboot|--suspend|--hibernate)
      if [ ! -f "$HOME/.config/hex-sound-off" ] && pactl info >/dev/null 2>&1; then
        paplay --volume=52000 /usr/share/sounds/hex/logout.wav >/dev/null 2>&1 &
        sleep 1.5
      fi
      break ;;
  esac
done
exec /usr/bin/xfce4-session-logout "$@"
