#!/usr/bin/python3
"""HEX Quick Settings (Win+A): the things you change every day, in one small panel."""
import os, re, subprocess, threading, time
import gi
gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib

CLOSED = "/tmp/.hex-quick-closed-%d" % os.getuid()
NIGHT = os.path.expanduser("~/.config/hex-night")
CSS = b"""
window { background-color: #0a111c; }
.panel { background-color: #0a111c; padding: 16px; }
.head { font-size: 13px; font-weight: 700; color: #ecf4fa; }
.tile { background-image: none; background-color: #17283d; border: 1px solid #243f57; border-radius: 14px; padding: 10px 6px; color: #ecf4fa; min-height: 70px; min-width: 100px; }
.tile:hover { background-color: #1f3a55; }
.tile:checked { background-color: #14968a; border-color: #19b0a1; color: #ffffff; }
.tile:disabled { background-color: #101d2d; color: #6f879d; }
.ticon { font-size: 20px; }
.tname { font-size: 12px; font-weight: 700; }
.tstate { font-size: 10px; color: #c5d4e3; }
.row { background-color: #0e1a2b; border-radius: 14px; border: 1px solid #1d3347; padding: 8px 12px; }
.rowicon { font-size: 16px; }
button.round { background-image: none; background-color: #17283d; border: 1px solid #243f57; border-radius: 12px; color: #ecf4fa; min-height: 40px; }
button.round:hover { background-color: #1f3a55; }
button.wide { background-image: none; background-color: #0e1a2b; border: 1px solid #1d3347; border-radius: 12px; color: #96ebcd; min-height: 36px; }
button.wide:hover { background-color: #17283d; }
scale trough { background-color: #223a52; min-height: 6px; border-radius: 3px; }
scale highlight { background-color: #19b0a1; border-radius: 3px; }
scale slider { background-color: #ffffff; min-width: 16px; min-height: 16px; border-radius: 8px; border: none; }
.muted { font-size: 11px; color: #9fb3c8; }
"""

def sh(cmd, timeout=4):
    try: return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except Exception: return ""
def bg(cmd): subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

class Quick(Gtk.Window):
    def __init__(self):
        super().__init__(title="HEX Quick Settings")
        self.shown_at = time.time(); self.closing = False; self.busy = True; self.w = 380
        self.set_decorated(False); self.set_skip_taskbar_hint(True); self.set_type_hint(Gdk.WindowTypeHint.DIALOG); self.set_keep_above(True); self.set_resizable(False)
        mon = Gdk.Display.get_default().get_primary_monitor() or Gdk.Display.get_default().get_monitor(0); wa = mon.get_workarea()
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); col.get_style_context().add_class("panel"); col.set_size_request(self.w, -1); self.add(col)
        h = Gtk.Label(label="Quick settings"); h.set_xalign(0); h.get_style_context().add_class("head"); col.pack_start(h, False, False, 0)
        grid = Gtk.Grid(column_spacing=8, row_spacing=8, column_homogeneous=True); col.pack_start(grid, False, False, 0)
        self.tiles = {}
        for i, (key, ico, name) in enumerate((("wifi", "📶", "Wi-Fi"), ("bt", "🔵", "Bluetooth"), ("dnd", "🔕", "Focus"), ("night", "🌙", "Night light"), ("dark", "🌗", "Dark mode"), ("fx", "✨", "Animations"))):
            b = Gtk.ToggleButton(); b.get_style_context().add_class("tile"); v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            a = Gtk.Label(label=ico); a.get_style_context().add_class("ticon")
            n = Gtk.Label(label=name); n.get_style_context().add_class("tname")
            s = Gtk.Label(label="..."); s.get_style_context().add_class("tstate")
            for x in (a, n, s): v.pack_start(x, False, False, 0)
            b.add(v); b.connect("toggled", self.on_toggle, key); grid.attach(b, i % 3, i // 3, 1, 1); self.tiles[key] = (b, s)
        wifi = Gtk.Button(label="📶  Wi-Fi networks..."); wifi.get_style_context().add_class("wide"); wifi.connect("clicked", lambda *_: (bg("python3 /usr/local/bin/hex-wifi"), self.close_now())); col.pack_start(wifi, False, False, 0)
        self.vol = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1); self.vol.set_draw_value(False); self.vol.set_hexpand(True); self.vol.set_size_request(120, -1)
        self.mute = Gtk.Button(label="🔊"); self.mute.get_style_context().add_class("round"); self.mute.connect("clicked", self.on_mute)
        col.pack_start(self.slider_row(self.mute, self.vol), False, False, 0)
        self.vol.connect("value-changed", lambda s: None if self.busy else bg("pactl set-sink-volume @DEFAULT_SINK@ %d%%" % s.get_value()))
        self.bri = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 5, 100, 1); self.bri.set_draw_value(False); self.bri.set_hexpand(True); self.bri.set_size_request(120, -1)
        ico = Gtk.Label(label="☀️"); ico.get_style_context().add_class("rowicon"); self.bri_row = self.slider_row(ico, self.bri); self.bri_row.set_no_show_all(True); col.pack_start(self.bri_row, False, False, 0)
        self.bri.connect("value-changed", lambda s: None if self.busy else bg("brightnessctl -c backlight set %d%%" % s.get_value()))
        acts = Gtk.Box(spacing=6, homogeneous=True); col.pack_start(acts, False, False, 0)
        for label, cmd in (("📸", "xfce4-screenshooter -r"), ("🖼️", "bash /usr/local/bin/hex-wallpaper next"), ("⚙️", "python3 /usr/local/bin/hex-settings"), ("🔒", "xflock4"), ("⏻", "bash /usr/local/bin/hex-power")):
            b = Gtk.Button(label=label); b.get_style_context().add_class("round")
            b.connect("clicked", lambda _b, c=cmd: (bg(c), self.close_now() if "wallpaper" not in c else None)); acts.pack_start(b, True, True, 0)
        self.info = Gtk.Label(label=time.strftime("%A, %d %B   %H:%M")); self.info.set_xalign(0); self.info.get_style_context().add_class("muted"); col.pack_start(self.info, False, False, 0)
        self.connect("key-press-event", lambda w, e: self.close_now() if e.keyval == Gdk.KEY_Escape else None)
        self.connect("focus-out-event", lambda *_: GLib.timeout_add(150, self.maybe_close))
        self.connect("destroy", lambda *_: (open(CLOSED, "w").write(str(time.time())), Gtk.main_quit()))
        self.show_all(); self.resize(self.w, 1); h2 = self.get_preferred_height()[1]
        self.tx, self.ty = wa.x + wa.width - self.w - 8, wa.y + wa.height - h2 - 8; self.sx = wa.x + wa.width
        self.move(self.sx, self.ty); self.present(); self.step = 0; GLib.timeout_add(14, self.slide)
        threading.Thread(target=self.gather, daemon=True).start()

    def slider_row(self, left, scale):
        r = Gtk.Box(spacing=12); r.get_style_context().add_class("row"); r.pack_start(left, False, False, 0); r.pack_start(scale, True, True, 0); return r
    def slide(self):
        self.step += 1; k = min(1.0, self.step / 12.0); e = 1 - (1 - k) ** 3
        self.move(int(self.sx + (self.tx - self.sx) * e), self.ty); return k < 1.0
    def maybe_close(self):
        if time.time() - self.shown_at > 0.8 and not self.is_active(): self.close_now()
        return False
    def close_now(self):
        if not self.closing: self.closing = True; self.destroy()
        return False

    def gather(self):
        d = {}
        dev = sh("nmcli -t -f TYPE device"); d["wifi_hw"] = "wifi" in dev
        d["wifi"] = sh("nmcli radio wifi") == "enabled"
        bt = sh("rfkill list bluetooth"); d["bt_hw"] = bool(bt); d["bt"] = "Soft blocked: no" in bt
        d["dnd"] = sh("xfconf-query -c xfce4-notifyd -p /do-not-disturb") == "true"
        d["night"] = os.path.exists(NIGHT)
        d["fx"] = bool(sh("pgrep -x picom"))
        m = re.findall(r"(\d+)%", sh("pactl get-sink-volume @DEFAULT_SINK@")); d["vol"] = int(m[0]) if m else None
        d["muted"] = "yes" in sh("pactl get-sink-mute @DEFAULT_SINK@")
        b = sh("brightnessctl -c backlight -m").split(","); d["bri"] = int(b[3].rstrip("%")) if len(b) >= 4 and b[3].endswith("%") else None
        GLib.idle_add(self.apply, d)
    def apply(self, d):
        self.busy = True
        theme = (Gtk.Settings.get_default().get_property("gtk-theme-name") or "").lower()
        rows = {"wifi": (d["wifi"] and d["wifi_hw"], ("On" if d["wifi"] else "Off") if d["wifi_hw"] else "No adapter"),
                "bt": (d["bt"] and d["bt_hw"], ("On" if d["bt"] else "Off") if d["bt_hw"] else "No adapter"),
                "dnd": (d["dnd"], "No pop-ups" if d["dnd"] else "Off"), "night": (d["night"], "Warm" if d["night"] else "Off"),
                "dark": ("dark" in theme, "Dark" if "dark" in theme else "Light"), "fx": (d["fx"], "Smooth" if d["fx"] else "Off")}
        for k, (on, text) in rows.items():
            b, s = self.tiles[k]; b.set_active(bool(on)); s.set_text(text)
        self.tiles["bt"][0].set_sensitive(d["bt_hw"])
        if d["vol"] is not None: self.vol.set_value(d["vol"])
        self.mute.set_label("🔇" if d["muted"] else "🔊")
        if d["bri"] is not None: self.bri.set_value(d["bri"]); self.bri_row.show_all()
        self.hw_wifi = d["wifi_hw"]; self.busy = False; return False

    def on_mute(self, *_):
        bg("pactl set-sink-mute @DEFAULT_SINK@ toggle"); self.mute.set_label("🔊" if self.mute.get_label() == "🔇" else "🔇")
    def on_toggle(self, btn, key):
        if self.busy: return
        on = btn.get_active()
        if key == "wifi":
            if not getattr(self, "hw_wifi", False): bg("python3 /usr/local/bin/hex-wifi"); self.close_now(); return
            bg("nmcli radio wifi %s" % ("on" if on else "off"))
        elif key == "bt": bg("rfkill %s bluetooth" % ("unblock" if on else "block"))
        elif key == "dnd": bg("xfconf-query -c xfce4-notifyd -p /do-not-disturb -n -t bool -s %s" % ("true" if on else "false"))
        elif key == "night":
            if on: open(NIGHT, "w").write("on"); bg("redshift -P -O 3700")
            else:
                try: os.remove(NIGHT)
                except OSError: pass
                bg("redshift -x")
        elif key == "dark":
            t, i = ("Arc-Dark", "Papirus-Dark") if on else ("Arc", "Papirus")
            bg("xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s %s; xfconf-query -c xsettings -p /Net/IconThemeName -n -t string -s %s; xfconf-query -c xfwm4 -p /general/theme -n -t string -s %s" % (t, i, t))
        elif key == "fx": bg("bash /usr/local/bin/hex-fx %s" % ("smooth" if on else "off"))
        self.tiles[key][1].set_text("On" if on else "Off")

def main():
    prov = Gtk.CssProvider(); prov.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    Quick(); Gtk.main()

if __name__ == "__main__":
    main()
