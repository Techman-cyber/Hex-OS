#!/usr/bin/python3
"""HEX Quick Settings (Win+A): Wi-Fi, Bluetooth, volume, brightness, night light, focus mode, dark mode and more."""
import os, re, subprocess, time
import gi
gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib

CLOSED = "/tmp/.hex-quick-closed-%d" % os.getuid()
NIGHT = os.path.expanduser("~/.config/hex-night")
CSS = b"""
window { background-color: #0a111c; }
.panel { background-color: #0a111c; padding: 16px; }
.head { font-size: 12px; font-weight: 700; color: #96ebcd; letter-spacing: 1px; }
.tile { background-image: none; background-color: #17283d; border: 1px solid #2a4a5e; border-radius: 14px; padding: 12px; color: #ecf4fa; min-height: 58px; }
.tile:hover { background-color: #1f3a55; }
.tile:checked { background-color: #14968a; border-color: #19b0a1; color: #ffffff; }
.tname { font-size: 14px; font-weight: 700; }
.tstate { font-size: 11px; color: #c5d4e3; }
.row { background-color: #0e1a2b; border-radius: 14px; border: 1px solid #1d3347; padding: 10px 14px; }
.rowicon { font-size: 18px; }
button.round { background-image: none; background-color: #17283d; border: 1px solid #2a4a5e; border-radius: 12px; color: #ecf4fa; min-height: 40px; }
button.round:hover { background-color: #1f3a55; }
scale trough { background-color: #223a52; min-height: 6px; border-radius: 3px; }
scale highlight { background-color: #19b0a1; border-radius: 3px; }
scale slider { background-color: #ffffff; min-width: 18px; min-height: 18px; border-radius: 9px; border: none; }
.muted { font-size: 11px; color: #9fb3c8; }
"""

def sh(cmd, timeout=4):
    try: return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except Exception: return ""
def bg(cmd): subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

class Quick(Gtk.Window):
    def __init__(self):
        super().__init__(title="HEX Quick Settings")
        self.shown_at = time.time(); self.closing = False; self.busy = False
        self.set_decorated(False); self.set_skip_taskbar_hint(True); self.set_type_hint(Gdk.WindowTypeHint.DIALOG); self.set_keep_above(True); self.set_resizable(False)
        mon = Gdk.Display.get_default().get_primary_monitor() or Gdk.Display.get_default().get_monitor(0)
        wa = mon.get_workarea(); self.w = 400
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12); col.get_style_context().add_class("panel"); col.set_size_request(self.w, -1); self.add(col)
        h = Gtk.Label(label="QUICK SETTINGS"); h.set_xalign(0); h.get_style_context().add_class("head"); col.pack_start(h, False, False, 0)
        grid = Gtk.Grid(column_spacing=10, row_spacing=10, column_homogeneous=True); col.pack_start(grid, False, False, 0)
        self.tiles = {}
        defs = [("wifi", "📶", "Wi-Fi"), ("bt", "🔵", "Bluetooth"), ("dnd", "🔕", "Focus"), ("night", "🌙", "Night light"), ("dark", "🌗", "Dark mode"), ("fx", "✨", "Animations")]
        for i, (key, ico, name) in enumerate(defs):
            b = Gtk.ToggleButton(); b.get_style_context().add_class("tile")
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            n = Gtk.Label(label="%s  %s" % (ico, name)); n.set_xalign(0); n.set_ellipsize(3); n.get_style_context().add_class("tname")
            s = Gtk.Label(label=""); s.set_xalign(0); s.get_style_context().add_class("tstate")
            v.pack_start(n, False, False, 0); v.pack_start(s, False, False, 0); b.add(v)
            b.connect("toggled", self.on_toggle, key); grid.attach(b, i % 2, i // 2, 1, 1); self.tiles[key] = (b, s)
        # volume
        self.vol = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1); self.vol.set_draw_value(False); self.vol.set_hexpand(True); self.vol.set_size_request(120, -1)
        self.mute = Gtk.Button(label="🔊"); self.mute.get_style_context().add_class("round"); self.mute.connect("clicked", self.on_mute)
        col.pack_start(self.slider_row(self.mute, self.vol), False, False, 0)
        self.vol.connect("value-changed", lambda s: None if self.busy else bg("pactl set-sink-volume @DEFAULT_SINK@ %d%%" % s.get_value()))
        # brightness
        self.bri = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 5, 100, 1); self.bri.set_draw_value(False); self.bri.set_hexpand(True); self.bri.set_size_request(120, -1)
        ico = Gtk.Label(label="☀️"); ico.get_style_context().add_class("rowicon")
        self.bri_row = self.slider_row(ico, self.bri); col.pack_start(self.bri_row, False, False, 0)
        self.bri.connect("value-changed", lambda s: None if self.busy else bg("brightnessctl set %d%%" % s.get_value()))
        # action buttons
        acts = Gtk.Box(spacing=6, homogeneous=True); col.pack_start(acts, False, False, 0)
        for label, cmd in (("📸", "xfce4-screenshooter -r"), ("🖼️", "bash /usr/local/bin/hex-wallpaper next"), ("⚙️", "xfce4-settings-manager"), ("🔒", "xflock4"), ("⏻", "xfce4-session-logout")):
            b = Gtk.Button(label=label); b.get_style_context().add_class("round")
            b.connect("clicked", lambda _b, c=cmd: (bg(c), self.close_now() if "wallpaper" not in c else None))
            acts.pack_start(b, True, True, 0)
        self.info = Gtk.Label(label=""); self.info.set_xalign(0); self.info.get_style_context().add_class("muted"); col.pack_start(self.info, False, False, 0)
        self.refresh()
        self.connect("key-press-event", lambda w, e: self.close_now() if e.keyval == Gdk.KEY_Escape else None)
        self.connect("focus-out-event", lambda *_: GLib.timeout_add(150, self.maybe_close))
        self.connect("destroy", lambda *_: (open(CLOSED, "w").write(str(time.time())), Gtk.main_quit()))
        self.show_all(); self.resize(self.w, 1)
        h2 = self.get_preferred_height()[1]; self.h = h2
        self.tx, self.ty = wa.x + wa.width - self.w - 8, wa.y + wa.height - h2 - 8; self.sx = wa.x + wa.width
        self.move(self.sx, self.ty); self.present(); self.step = 0; GLib.timeout_add(14, self.slide)

    def slider_row(self, left, scale):
        r = Gtk.Box(spacing=12); r.get_style_context().add_class("row"); r.pack_start(left, False, False, 0); r.pack_start(scale, True, True, 0); return r
    def slide(self):
        self.step += 1; k = min(1.0, self.step / 14.0); e = 1 - (1 - k) ** 3
        self.move(int(self.sx + (self.tx - self.sx) * e), self.ty); return k < 1.0
    def maybe_close(self):
        if time.time() - self.shown_at > 0.8 and not self.is_active(): self.close_now()
        return False
    def close_now(self):
        if not self.closing: self.closing = True; self.destroy()
        return False

    # ---- state ----
    def state(self):
        wifi = sh("nmcli radio wifi") == "enabled"
        bt = "Soft blocked: no" in sh("rfkill list bluetooth")
        dnd = sh("xfconf-query -c xfce4-notifyd -p /do-not-disturb") == "true"
        night = os.path.exists(NIGHT)
        dark = sh("xfconf-query -c xsettings -p /Net/ThemeName").endswith("Dark")
        fx = "running" in sh("bash /usr/local/bin/hex-fx status")
        return {"wifi": (wifi, "On" if wifi else "Off"), "bt": (bt, "On" if bt else "Off"), "dnd": (dnd, "No pop-ups" if dnd else "Off"),
                "night": (night, "Warm colours" if night else "Off"), "dark": (dark, "Dark" if dark else "Light"), "fx": (fx, "Smooth" if fx else "Off")}
    def refresh(self):
        self.busy = True
        for k, (on, text) in self.state().items():
            b, s = self.tiles[k]; b.set_active(on); s.set_text(text)
        m = re.findall(r"(\d+)%", sh("pactl get-sink-volume @DEFAULT_SINK@"))
        self.vol.set_value(int(m[0]) if m else 0)
        self.mute.set_label("🔇" if "yes" in sh("pactl get-sink-mute @DEFAULT_SINK@") else "🔊")
        b = sh("brightnessctl -m").split(",")
        if len(b) >= 4 and b[3].endswith("%"): self.bri.set_value(int(b[3].rstrip("%")))
        else: self.bri_row.set_no_show_all(True); self.bri_row.hide()
        self.info.set_text(time.strftime("%A, %d %B   %H:%M"))
        self.busy = False

    def on_mute(self, *_):
        sh("pactl set-sink-mute @DEFAULT_SINK@ toggle"); self.refresh()
    def on_toggle(self, btn, key):
        if self.busy: return
        on = btn.get_active()
        if key == "wifi": sh("nmcli radio wifi %s" % ("on" if on else "off"))
        elif key == "bt": sh("rfkill %s bluetooth" % ("unblock" if on else "block"))
        elif key == "dnd": sh("xfconf-query -c xfce4-notifyd -p /do-not-disturb -n -t bool -s %s" % ("true" if on else "false"))
        elif key == "night":
            if on: open(NIGHT, "w").write("on"); bg("redshift -P -O 3700")
            else:
                try: os.remove(NIGHT)
                except OSError: pass
                bg("redshift -x")
        elif key == "dark":
            t, i = ("Arc-Dark", "Papirus-Dark") if on else ("Arc", "Papirus")
            sh("xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s %s" % t); sh("xfconf-query -c xsettings -p /Net/IconThemeName -n -t string -s %s" % i); sh("xfconf-query -c xfwm4 -p /general/theme -n -t string -s %s" % t)
        elif key == "fx": bg("bash /usr/local/bin/hex-fx %s" % ("smooth" if on else "off"))
        GLib.timeout_add(900, lambda: (self.refresh(), False)[1])

def main():
    prov = Gtk.CssProvider(); prov.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    Quick(); Gtk.main()

if __name__ == "__main__":
    main()
