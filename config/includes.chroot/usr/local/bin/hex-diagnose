#!/usr/bin/env bash
# Collects login and graphics information into ~/hex-diagnose.txt so a problem is easy to report.
OUT="$HOME/hex-diagnose.txt"
{
  echo "== HEX diagnose $(date)"
  echo "virtualization: $(systemd-detect-virt 2>&1)"
  echo "live session: $([ -d /run/live ] && echo yes || echo no)"
  echo; echo "== account"; id; getent passwd user; sudo -n passwd -S user 2>&1
  echo; echo "== services"; systemctl status hex-live-setup lightdm --no-pager -n 12 2>&1
  echo; echo "== lightdm config"; cat /etc/lightdm/lightdm.conf.d/* 2>&1
  echo; echo "== lightdm log"; tail -n 60 /var/log/lightdm/lightdm.log 2>&1
  echo; echo "== X errors"; grep -hE '\(EE\)|\(WW\)' /var/log/Xorg.0.log "$HOME/.local/share/xorg/Xorg.0.log" /var/log/lightdm/x-0.log 2>/dev/null | head -40
  echo; echo "== session errors"; tail -n 40 "$HOME/.xsession-errors" 2>&1
  echo; echo "== graphics"; lspci -nnk 2>&1 | grep -A3 -i vga; xrandr --query 2>&1 | head -8
  echo "compositing: $(xfconf-query -c xfwm4 -p /general/use_compositing 2>&1)  vblank: $(xfconf-query -c xfwm4 -p /general/vblank_mode 2>&1)"
  echo "blur: $(bash /usr/local/bin/hex-fx status)"
} > "$OUT" 2>&1
zenity --info --no-wrap --title="HEX troubleshooting" --text="Report saved to:\n$OUT\n\nSend that file when asking for help." 2>/dev/null
