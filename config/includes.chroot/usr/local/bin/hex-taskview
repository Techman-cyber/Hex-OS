#!/usr/bin/python3
"""HEX Task View (Win+Tab): every window on every virtual desktop in one screen."""
import time
import gi
gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0"); gi.require_version("Wnck", "3.0")
from gi.repository import Gtk, Gdk, GLib, GdkPixbuf, Wnck

CSS = b"""
window.tv { background-color: #070d17; }
.title { font-size: 26px; font-weight: 300; color: #f2f7fb; }
.deskhead { font-size: 15px; font-weight: 700; color: #ecf4fa; }
.deskhead.current { color: #96ebcd; }
.count { font-size: 12px; color: #9fb3c8; }
.desksec { background-color: #0e1a2b; border-radius: 18px; border: 1px solid #1d3347; padding: 14px 16px; }
.desksec.current { border: 2px solid #14968a; }
.card { background-color: #17283d; border-radius: 14px; border: 1px solid #2a4a5e; padding: 12px; min-width: 190px; }
.card:hover { background-color: #1f3a55; border-color: #14968a; }
.wname { font-size: 13px; color: #ecf4fa; }
.wapp { font-size: 11px; color: #9fb3c8; }
.empty { font-size: 13px; color: #6f879d; }
button.act { background-image: none; background-color: #14968a; color: #ffffff; border-radius: 12px; border: none; min-height: 36px; padding: 0 16px; font-weight: 700; }
button.link { background: none; border: none; box-shadow: none; color: #96ebcd; }
"""

def stamp(): return Gtk.get_current_event_time() or int(time.time())

class TaskView(Gtk.Window):
    def __init__(self):
        super().__init__(title="HEX Task View")
        self.wnck = Wnck.Screen.get_default(); self.wnck.force_update()
        scr = Gdk.Screen.get_default()
        vis = scr.get_rgba_visual()
        if vis is not None and scr.is_composited():
            self.set_visual(vis); self.set_app_paintable(True); self.connect("draw", self.on_draw)
        self.get_style_context().add_class("tv")
        self.set_decorated(False); self.set_keep_above(True); self.fullscreen()
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14); outer.set_border_width(34); self.add(outer)
        head = Gtk.Box(spacing=10); outer.pack_start(head, False, False, 0)
        t = Gtk.Label(label="Task view"); t.get_style_context().add_class("title"); head.pack_start(t, False, False, 0)
        close = Gtk.Button(label="Close  (Esc)"); close.get_style_context().add_class("link"); close.connect("clicked", lambda *_: self.close_now()); head.pack_end(close, False, False, 0)
        add = Gtk.Button(label="+ New desktop"); add.get_style_context().add_class("act"); add.connect("clicked", self.add_desktop); head.pack_end(add, False, False, 8)
        sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC); outer.pack_start(sc, True, True, 0)
        self.rev = Gtk.Revealer(); self.rev.set_transition_type(Gtk.RevealerTransitionType.SLIDE_DOWN); self.rev.set_transition_duration(260); sc.add(self.rev)
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14); self.rev.add(self.body)
        self.connect("key-press-event", lambda w, e: self.close_now() if e.keyval == Gdk.KEY_Escape else None)
        self.connect("button-press-event", lambda w, e: self.close_now())
        self.connect("destroy", lambda *_: Gtk.main_quit())
        self.shown_at = time.time()
        self.connect("focus-out-event", lambda *_: GLib.timeout_add(250, self.maybe_close))
        self.build(); self.show_all(); self.present()
        GLib.timeout_add(60, lambda: (self.rev.set_reveal_child(True), False)[1])

    def on_draw(self, w, cr):
        cr.set_source_rgba(0.03, 0.05, 0.09, 0.93); cr.set_operator(1); cr.paint(); cr.set_operator(2); return False
    def maybe_close(self):
        if time.time() - self.shown_at > 1.0 and not self.is_active(): self.close_now()
        return False
    def close_now(self):
        self.destroy(); return False

    def windows(self):
        out = []
        for w in self.wnck.get_windows():
            if w.is_skip_tasklist(): continue
            if w.get_window_type() not in (Wnck.WindowType.NORMAL, Wnck.WindowType.DIALOG, Wnck.WindowType.UTILITY): continue
            if w.get_name() == "HEX Task View": continue
            out.append(w)
        return out

    def build(self):
        for ch in self.body.get_children(): self.body.remove(ch)
        spaces = self.wnck.get_workspaces(); active = self.wnck.get_active_workspace(); wins = self.windows()
        for ws in spaces:
            mine = [w for w in wins if w.get_workspace() is not None and w.get_workspace().get_number() == ws.get_number()]
            cur = active is not None and ws.get_number() == active.get_number()
            sec = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); sec.get_style_context().add_class("desksec")
            if cur: sec.get_style_context().add_class("current")
            h = Gtk.Box(spacing=10)
            name = "Desktop %d" % (ws.get_number() + 1) if (not ws.get_name() or ws.get_name().startswith("Workspace ")) else ws.get_name()
            lab = Gtk.Label(label=name + ("   (current)" if cur else "")); lab.get_style_context().add_class("deskhead")
            if cur: lab.get_style_context().add_class("current")
            h.pack_start(lab, False, False, 0)
            cnt = Gtk.Label(label="%d window%s" % (len(mine), "" if len(mine) == 1 else "s")); cnt.get_style_context().add_class("count"); h.pack_start(cnt, False, False, 0)
            go = Gtk.Button(label="Go to this desktop"); go.get_style_context().add_class("link")
            go.connect("clicked", lambda _b, s=ws: (s.activate(stamp()), self.close_now())); h.pack_end(go, False, False, 0)
            if ws.get_number() == len(spaces) - 1 and not mine and len(spaces) > 1:
                rm = Gtk.Button(label="Remove"); rm.get_style_context().add_class("link"); rm.connect("clicked", self.remove_last); h.pack_end(rm, False, False, 0)
            sec.pack_start(h, False, False, 0)
            if not mine:
                e = Gtk.Label(label="No windows here. Switch to this desktop and open something."); e.get_style_context().add_class("empty"); e.set_xalign(0); sec.pack_start(e, False, False, 0)
            else:
                flow = Gtk.FlowBox(); flow.set_selection_mode(Gtk.SelectionMode.NONE); flow.set_max_children_per_line(8); flow.set_column_spacing(12); flow.set_row_spacing(12)
                for w in mine: flow.add(self.card(w, spaces))
                sec.pack_start(flow, False, False, 0)
            self.body.pack_start(sec, False, False, 0)
        sticky = [w for w in wins if w.get_workspace() is None]
        if sticky:
            sec = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); sec.get_style_context().add_class("desksec")
            l = Gtk.Label(label="On all desktops"); l.get_style_context().add_class("deskhead"); l.set_xalign(0); sec.pack_start(l, False, False, 0)
            flow = Gtk.FlowBox(); flow.set_selection_mode(Gtk.SelectionMode.NONE); flow.set_column_spacing(12)
            for w in sticky: flow.add(self.card(w, spaces))
            sec.pack_start(flow, False, False, 0); self.body.pack_start(sec, False, False, 0)
        self.body.show_all()

    def card(self, w, spaces):
        b = Gtk.Button(); b.get_style_context().add_class("card"); b.set_relief(Gtk.ReliefStyle.NONE)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        ic = w.get_icon()
        v.pack_start(Gtk.Image.new_from_pixbuf(ic.scale_simple(56, 56, GdkPixbuf.InterpType.BILINEAR) if ic else None), False, False, 0)
        n = Gtk.Label(label=w.get_name()); n.set_max_width_chars(24); n.set_ellipsize(3); n.get_style_context().add_class("wname"); v.pack_start(n, False, False, 0)
        a = Gtk.Label(label=w.get_application().get_name() if w.get_application() else ""); a.get_style_context().add_class("wapp"); v.pack_start(a, False, False, 0)
        b.add(v)
        b.connect("clicked", lambda _b, win=w: self.focus(win))
        b.connect("button-press-event", lambda _b, e, win=w: self.menu(e, win, spaces) if e.button == 3 else False)
        return b
    def focus(self, w):
        ws = w.get_workspace()
        if ws is not None: ws.activate(stamp())
        if w.is_minimized(): w.unminimize(stamp())
        w.activate(stamp()); self.close_now()
    def menu(self, ev, w, spaces):
        m = Gtk.Menu()
        for ws in spaces:
            it = Gtk.MenuItem(label="Move to Desktop %d" % (ws.get_number() + 1))
            it.connect("activate", lambda _i, s=ws, win=w: (win.move_to_workspace(s), GLib.timeout_add(250, self.rebuild)))
            m.append(it)
        c = Gtk.MenuItem(label="Close window"); c.connect("activate", lambda *_: (w.close(stamp()), GLib.timeout_add(400, self.rebuild))); m.append(c)
        m.show_all(); m.popup_at_pointer(ev); return True
    def rebuild(self): self.build(); return False
    def add_desktop(self, *_):
        self.wnck.change_workspace_count(self.wnck.get_workspace_count() + 1); GLib.timeout_add(300, self.rebuild)
    def remove_last(self, *_):
        self.wnck.change_workspace_count(max(1, self.wnck.get_workspace_count() - 1)); GLib.timeout_add(300, self.rebuild)

def main():
    prov = Gtk.CssProvider(); prov.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    TaskView(); Gtk.main()

if __name__ == "__main__":
    main()
