favorites=firefox-esr.desktop,thunar.desktop,libreoffice-writer.desktop,libreoffice-calc.desktop,libreoffice-impress.desktop,hex-notepad.desktop,galculator.desktop,vlc.desktop,xfce4-terminal.desktop,hex-settings.desktop,hex-welcome.desktop,hex-install.desktop
button-icon=hex-start
show-button-title=false
show-button-icon=true
launcher-show-name=true
launcher-show-description=true
launcher-show-tooltip=true
position-search-alternate=false
position-commands-alternate=false
menu-width=520
menu-height=560
show-command-lockscreen=false
show-command-switchuser=false
show-command-logoff=true
show-command-shutdown=true
show-command-restart=true
show-command-suspend=true
command-logout=xfce4-session-logout --logout --fast
command-shutdown=xfce4-session-logout --halt --fast
command-restart=xfce4-session-logout --reboot --fast
confirm-session-command=true
command-settings=python3 /usr/local/bin/hex-settings
