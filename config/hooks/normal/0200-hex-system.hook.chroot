#!/bin/sh
# Runs inside the new system while the ISO is built. Every step is best-effort.
sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf 2>/dev/null || true
systemctl enable ufw 2>/dev/null || true
echo /usr/sbin/lightdm > /etc/X11/default-display-manager 2>/dev/null || true
systemctl enable lightdm 2>/dev/null || true
systemctl enable hex-live-setup.service 2>/dev/null || true
for f in /etc/calamares/branding/*/branding.desc; do
  [ -f "$f" ] && sed -i -E 's/Debian GNU\/Linux/HEX OS/g; s/^([[:space:]]*(productName|shortProductName|bootloaderEntryName):[[:space:]]*).*/\1HEX OS/' "$f"
done
sed -i 's/Install Debian/Install HEX OS/g; s/^Name=.*/Name=Install HEX OS/' /usr/share/applications/install-debian.desktop 2>/dev/null || true
sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="HEX OS (based on Debian 12)"/; s/^NAME=.*/NAME="HEX OS"/' /etc/os-release 2>/dev/null || true
echo "HEX OS \\n \\l" > /etc/issue
# Firefox: no telemetry, no first-run popups
mkdir -p /usr/lib/firefox-esr/distribution
cat > /usr/lib/firefox-esr/distribution/policies.json <<'EOT'
{"policies":{"DisableTelemetry":true,"DisableFirefoxStudies":true,"DontCheckDefaultBrowser":true,"NoDefaultBookmarks":true,"OverrideFirstRunPage":"","OverridePostUpdatePage":""}}
EOT
# Friendly names: Notepad and Paint instead of Mousepad / mtPaint
for f in org.xfce.mousepad.desktop mousepad.desktop mtpaint.desktop; do
  [ -f /usr/share/applications/$f ] && sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nNoDisplay=true/' /usr/share/applications/$f
done
# The login screen helper may only be run through the one allowed sudo rule
chmod 440 /etc/sudoers.d/hex-greeter 2>/dev/null || true
visudo -cf /etc/sudoers.d/hex-greeter >/dev/null 2>&1 || rm -f /etc/sudoers.d/hex-greeter
# Boot animation
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme hex 2>/dev/null || true
  update-initramfs -u -k all 2>/dev/null || true
fi
sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT="quiet"/GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"/' /etc/default/grub 2>/dev/null || true
exit 0
